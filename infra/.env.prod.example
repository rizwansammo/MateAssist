# MateAssist production environment - template.
#
# Copy to /opt/MateAssist/infra/.env on the server and fill in. This file is a
# template with no real values; the real one never enters git.
#
#   cp .env.prod.example .env && chmod 600 .env
#
# Generate every secret with `openssl rand -base64 36`. Do not reuse a value
# between two of them: one leaked secret should not become three.

# ── Django ────────────────────────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_SECRET_KEY=
DJANGO_DEBUG=False
# 127.0.0.1 and localhost are required by the container healthcheck, which curls
# the health endpoint on the loopback. Without them the check is refused, the
# container reports "starting" forever while serving traffic perfectly, and any
# restart-on-unhealthy policy silently does nothing.
DJANGO_ALLOWED_HOSTS=mateassist.site,.mateassist.site,127.0.0.1,localhost

# Required by config/settings/prod.py. Must include every host the browser
# posts from, or every login returns a CSRF failure that reads like bad
# credentials. The leading dot covers all tenant subdomains.
CSRF_TRUSTED_ORIGINS=https://mateassist.site,https://*.mateassist.site

# Also required, also without a default - Django refuses to start without it.
# The SPAs are served from the same origin as the API, so CORS is not doing
# real work here; the setting still has to be present.
CORS_ALLOWED_ORIGIN_REGEXES=^https://([a-z0-9-]+\.)?mateassist\.site$

# The database is reached over the internal docker bridge and never leaves the
# host, so nothing terminates TLS on it. This setting defaults to "require",
# which makes every connection fail with a message about SSL rather than about
# configuration - a confusing half-hour if you have not seen it before.
DB_SSLMODE=disable

# Tenants are resolved from the subdomain, so this is the suffix stripped to
# find a workspace slug. Wrong value = every tenant login fails while the admin
# surface keeps working.
BASE_DOMAIN=mateassist.site

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_DB=mateassist
POSTGRES_USER=mateassist
POSTGRES_PASSWORD=

# The NOSUPERUSER role that all tenant traffic uses. This is what makes RLS
# real: connecting as the owner would leave every policy in place and enforcing
# nothing (D-020).
APP_DB_USER=mateassist_app
APP_DB_PASSWORD=

# Two aliases onto the same database, differing only in the role.
DATABASE_URL=postgres://mateassist:${POSTGRES_PASSWORD}@postgres:5432/mateassist
DATABASE_APP_URL=postgres://mateassist_app:${APP_DB_PASSWORD}@postgres:5432/mateassist

# ── Redis / Celery ────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── Object storage ────────────────────────────────────────────────────────────
# TWO sets of names, and they are not interchangeable.
#
# MINIO_* configures the MinIO container itself. S3_* is what the application
# reads (apps/knowledge/storage.py). Setting only the first pair leaves the app
# with empty credentials - and because those settings default to "", nothing
# fails at startup. It fails on the first upload with "a non-empty Access Key
# must be provided", which reads like a MinIO fault rather than a missing
# variable.
#
# The values must match.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET_NAME=mateassist-runbooks
S3_ACCESS_KEY_ID=          # same as MINIO_ROOT_USER
S3_SECRET_ACCESS_KEY=      # same as MINIO_ROOT_PASSWORD
S3_REGION=us-east-1

# The bucket is NOT created on demand. Create it once after the stack is up:
#   docker run --rm --network mateassist_internal --entrypoint sh minio/mc -c \
#     "mc alias set local http://minio:9000 USER PASS && \
#      mc mb --ignore-existing local/mateassist-runbooks && \
#      mc anonymous set none local/mateassist-runbooks"

# ── Credential vault ──────────────────────────────────────────────────────────
# AES-256-GCM key encryption key. LOSING THIS ORPHANS EVERY STORED PROVIDER
# CREDENTIAL - they cannot be decrypted without it and would all need re-entering.
# Back it up somewhere that is not this server.
MATEASSIST_VAULT_KEY=

# ── Email (escalations) ───────────────────────────────────────────────────────
# A-008: unresolved issues are handed to a human by email. Without these, the
# escalation button reports failure rather than silently dropping the message.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=MateAssist <noreply@mateassist.site>
DEFAULT_SUPPORT_EMAIL=

# ── Provisioning (read by `manage.py provision`) ──────────────────────────────
# Used once at first deploy. Existing accounts keep their passwords on re-run
# unless --reset-passwords is passed.
PLATFORM_OWNER_EMAIL=
PLATFORM_OWNER_PASSWORD=
PLATFORM_OWNER_NAME=

TENANT_NAME=
TENANT_SLUG=
TENANT_PLAN=ENTERPRISE
TENANT_REGION=us-east-1
TENANT_SUPPORT_EMAIL=

TENANT_ADMIN_EMAIL=
TENANT_ADMIN_PASSWORD=
TENANT_ADMIN_NAME=

TENANT_USER_EMAIL=
TENANT_USER_PASSWORD=
TENANT_USER_NAME=

# ── Images ────────────────────────────────────────────────────────────────────
# Pin a version tag to know exactly what is running, and to roll back by editing
# one line. `latest` is convenient and tells you nothing after the fact.
MATEASSIST_BACKEND_IMAGE=ghcr.io/rizwansammo/mateassist-backend:latest
MATEASSIST_PORTAL_IMAGE=ghcr.io/rizwansammo/mateassist-portal:latest
MATEASSIST_ADMIN_IMAGE=ghcr.io/rizwansammo/mateassist-admin:latest

# ── Loopback ports ────────────────────────────────────────────────────────────
# Chosen against what was already listening on MateServer. Nothing binds a
# public interface; the host nginx is the only way in.
BACKEND_PORT=8010
PORTAL_PORT=3010
ADMIN_PORT=3011

# ── NOT SET ON PURPOSE ────────────────────────────────────────────────────────
# MATEASSIST_ALLOW_DEMO_DATA - its absence is what stops seed_dev, ingest_demo,
# seed_runbooks, chat_demo and usage_demo from writing fabricated tenants and
# "VPN Runbook (demo)" into a customer's workspace (D-146). Do not add it here.
