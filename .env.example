# MateAssist — environment contract
# ============================================================================
# Copy to .env and fill every value marked <generate> or <required>.
#   pwsh infra/scripts/generate-secrets.ps1     # creates .env with real secrets
#
# .env is gitignored. This file is the committed contract — keep them in sync.
# Decision IDs (D-nnn) refer to docs/DECISIONS.md.
# ============================================================================

# ── Django core ─────────────────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=<generate>
DJANGO_DEBUG=1
# .localhost covers subdomain tenancy in dev (D-021): netswitch.localhost
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.localhost
BASE_DOMAIN=localhost:8000
DJANGO_PORT=8000

# ── Credential vault (D-070, D-071) ─────────────────────────────────────────
# 32 raw bytes, base64-encoded — the KEK for AES-256-GCM envelope encryption of
# provider API keys. Rotating this makes every stored ProviderKey unreadable.
MATEASSIST_VAULT_KEY=<generate>

# ── PostgreSQL 17 + pgvector (D-011) ────────────────────────────────────────
# NOTE: host port is 5433, not 5432. A native postgresql-x64-17 service already
# occupies 5432 on this machine. See DECISIONS.md amendment A-001.
POSTGRES_DB=mateassist
POSTGRES_USER=mateassist
POSTGRES_PASSWORD=<generate>
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
DATABASE_URL=postgresql://mateassist:<generate>@127.0.0.1:5433/mateassist

# ── Redis (D-012) ───────────────────────────────────────────────────────────
# NOTE: host port is 6380, not 6379. A native redis-server already occupies
# 6379 on this machine. See DECISIONS.md amendment A-001.
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_URL=redis://127.0.0.1:6380/0
CELERY_BROKER_URL=redis://127.0.0.1:6380/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6380/2

# ── Object storage — MinIO / S3 (D-013) ─────────────────────────────────────
MINIO_ROOT_USER=mateassist
MINIO_ROOT_PASSWORD=<generate>
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_BUCKET_NAME=mateassist-documents
S3_ACCESS_KEY_ID=mateassist
S3_SECRET_ACCESS_KEY=<generate>
S3_REGION=us-east-1
S3_USE_SSL=0

# ── AI engines (D-040, D-041) ───────────────────────────────────────────────
# Model IDs are configuration, never constants — a provider deprecation is an
# .env change, not a refactor. Subject to the Phase 1 verification gate.
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL_CHAT=deepseek-chat
DEEPSEEK_MODEL_REASONER=deepseek-reasoner
GEMINI_MODEL_VISION=gemini-2.5-flash

# Bootstrap keys — DEV ONLY, and ONLY for the Phase 1 verification gate that
# probes each provider's model list. Application code never reads these: at
# runtime every key comes from the encrypted vault (D-070/D-072). Leave blank
# until Phase 1. Open item O-3.
DEEPSEEK_API_KEY_BOOTSTRAP=
GEMINI_API_KEY_BOOTSTRAP=

# ── Embeddings (D-060) ──────────────────────────────────────────────────────
# 384 is baked into the vector() column and the HNSW index. Changing EMBEDDING_MODEL
# without changing EMBEDDING_DIM will corrupt retrieval silently.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
EMBEDDING_QUERY_PREFIX=Represent this sentence for searching relevant passages:
HF_HOME=./.cache/huggingface

# ── RAG tuning (D-055, D-056, D-057) ────────────────────────────────────────
CHUNK_TARGET_TOKENS=512
CHUNK_OVERLAP_RATIO=0.15
RETRIEVAL_TOP_K=20
RETRIEVAL_RRF_K=60
RETRIEVAL_TOP_N=6
HNSW_M=16
HNSW_EF_CONSTRUCTION=64

# ── Ingestion limits (D-058, D-131) ─────────────────────────────────────────
UPLOAD_MAX_BYTES=52428800
UPLOAD_ALLOWED_EXTENSIONS=.pdf,.docx,.md
VISION_MIN_IMAGE_PIXELS=10000
VISION_MAX_IMAGES_PER_DOCUMENT=400

# ── Frontend (D-145: two separate bundles) ──────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000/api/v1
PORTAL_PORT=5175
ADMIN_PORT=5174
